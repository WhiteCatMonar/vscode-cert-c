{
  "name": "vscode-cert-c",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0-alpha",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cert-c.checkWorkspace",
        "title": "%commands.checkWorkspace.title%"
      },
      {
        "command": "cert-c.clearDiagnostics",
        "title": "%commands.clearDiagnostics.title%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "certC.messageLanguage": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "%configuration.messageLanguage.enum.en%",
            "%configuration.messageLanguage.enum.ja%"
          ],
          "description": "%configuration.messageLanguage.description%"
        },
        "certC.fileGlobs": {
          "type": "array",
          "default": [
            "**/*.c",
            "**/*.h"
          ],
          "items": {
            "type": "string"
          },
          "description": "%configuration.fileGlobs.description%"
        },
        "certC.excludeGlobs": {
          "type": "array",
          "default": [
            "**/.git/**",
            "**/.svn/**",
            "**/.hg/**",
            "**/build/**",
            "**/cmake-build-*/**",
            "**/Debug/**",
            "**/Release/**",
            "**/dist/**",
            "**/vendor/**",
            "**/third_party/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "%configuration.excludeGlobs.description%"
        },
        "certC.analyzeOnChange": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.analyzeOnChange.description%"
        },
        "certC.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.analyzeOnSave.description%"
        },
        "certC.analyzeDebounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "%configuration.analyzeDebounceMs.description%"
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "cargo build --manifest-path analyzer-wasm/Cargo.toml --target wasm32-unknown-unknown --release",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "compile": "npm run build:wasm && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.9.0"
  }
}
